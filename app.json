{
  "expo": {
    "name": "MVRT Scouting App",
    "icon": "./assets/mvrt-icon.png",
    "version": "1.0.0",
    "slug": "scout-app",
    "ios": {
      "bundleIdentifier": "com.mvrt.scout",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "com.mvrt.scout",
      "versionCode": 1
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MVRT Scout App to access your camera."
        }
      ]
    ]
  }
}
